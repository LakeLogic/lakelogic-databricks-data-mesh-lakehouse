		formatString: #,0.00
		lineageTag: 8fd49665-5153-56d0-a0c7-109f283c03ec

	measure 'Total impressions (mart acquisition cost)' = SUM('gold_mart_acquisition_cost'[impressions])
		formatString: #,0
